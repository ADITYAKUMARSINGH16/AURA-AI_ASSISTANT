# ── Ollama models (REQUIRED) ─────────────────────────────
# Main reasoning model. Must match a locally pulled model: `ollama list`
OLLAMA_MODEL=gemma4:e2b
# Dedicated vision model for screenshots / uploaded images.
# Keep this DIFFERENT from OLLAMA_MODEL: text-only models hallucinate images.
OLLAMA_VISION_MODEL=qwen3-vl:4b

# ── Performance (optional) ───────────────────────────────
# Context window per request. Lower this if VRAM is exhausted on small GPUs.
OLLAMA_NUM_CTX=8192
# How long an unused model stays loaded in Ollama (e.g. 5m, 1h, -1 = forever).
OLLAMA_KEEP_ALIVE=5m

# ── Intent router (optional) ─────────────────────────────
# The router costs one extra LLM call per message (~10-30s on 4 GB VRAM GPUs).
# Set to "off" to skip routing and always expose the full toolset instead.
AURA_INTENT_ROUTER=on

# ── Text-to-Speech (Neural Voice) ───────────────────────────
# TTS Backend: 'edge' (cloud neural, free, zero-setup) or 'kokoro' (100% offline local neural)
AURA_TTS_BACKEND=edge
# Neural voice for speech output (e.g. en-US-JennyNeural, en-US-AriaNeural, en-US-AvaMultilingualNeural)
AURA_TTS_VOICE=en-US-JennyNeural
# Speaking rate adjustment (e.g. +0%, -5%, +10%)
AURA_TTS_RATE=+0%

# ── Wake word (optional) ─────────────────────────────────
# Path to a custom hey_aura ONNX/TFLite model (default: ./models/hey_aura.onnx)
AURA_WAKEWORD_MODEL=models/hey_aura.onnx
# Detection threshold 0..1 (higher = fewer false accepts). Default 0.60
AURA_WAKEWORD_THRESHOLD=0.60
# Higher threshold applied while AURA is speaking (barge-in guard). Default 0.85
AURA_WAKEWORD_SPEAKING_THRESHOLD=0.85
# Seconds to suppress repeat detections. Default 2.0
AURA_WAKEWORD_COOLDOWN=2.0
# Consecutive chunks required above threshold (lower = faster trigger). Default 3
AURA_WAKEWORD_PERSISTENCE=3
# Audio energy RMS cutoff (skip model on silence). Default 20.0
AURA_WAKEWORD_VAD_THRESHOLD=20.0
# Input device index or unique name substring (default: system default mic)
AURA_WAKEWORD_DEVICE=

# ── Visual computer-control agent (optional) ─────────────
# Overall time budget in seconds for execute_visual_task. Default 120
AURA_VISUAL_TASK_TIMEOUT=120

# ── Smart home (optional) ────────────────────────────────
# WiZ discovery broadcast address if auto-discovery needs a specific subnet
AURA_WIZ_BROADCAST=255.255.255.255
